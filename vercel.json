{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/",
      "destination": "/hu/",
      "permanent": false,
      "has": [
        {
          "type": "header",
          "key": "accept-language",
          "value": { "pre": "hu" }
        }
      ]
    },
    {
      "source": "/",
      "destination": "/de-at/",
      "permanent": false,
      "has": [
        {
          "type": "header",
          "key": "accept-language",
          "value": { "pre": "de" }
        }
      ]
    }
  ]
}
