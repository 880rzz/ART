      "name": [
        {
          "@value": "Magyar Péter portréja, Budapest, 2026",
          "@language": "hu"
        },
        {
          "@value": "Portrait of Péter Magyar, Budapest, 2026",
          "@language": "en"
        },
        {
          "@value": "Porträt von Péter Magyar, Budapest, 2026",
          "@language": "de"
        }
      ],
      "description": [
        {
          "@value": "A szoros, alulnézeti portré Magyar Pétert sötét Bocskai-ruhában és nemzeti kokárdával mutatja. Az alakot a világos ég választja el a háttértől, ami közvetlen, monumentális jelenlétet ad a képnek.",
          "@language": "hu"
        },
        {
          "@value": "The tight, low-angle portrait shows Péter Magyar in a dark Bocskai-style jacket with a Hungarian cockade. The pale sky isolates the figure and gives the photograph an immediate, monumental presence.",
          "@language": "en"
        },
        {
          "@value": "Das enge Porträt aus niedriger Perspektive zeigt Péter Magyar in dunkler Bocskai-Kleidung mit ungarischer Kokarde. Der helle Himmel löst die Figur vom Hintergrund und verleiht dem Bild eine unmittelbare, monumentale Präsenz.",
          "@language": "de"
        }
      ],
      "caption": [
        {
          "@value": "Magyar Péter a budapesti Hősök terén, 2026. március 15.",
          "@language": "hu"
        },
        {
          "@value": "Péter Magyar at Heroes’ Square, Budapest, 15 March 2026.",
          "@language": "en"
        },
        {
          "@value": "Péter Magyar auf dem Heldenplatz in Budapest, 15. März 2026.",
          "@language": "de"
        }
      ],
